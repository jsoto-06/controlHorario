rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Schedules collection (annual calendars with shifts and employees)
    match /schedules/{yearId} {
      allow read: if true;
      allow create, update: if request.resource.data.year is number &&
                              request.resource.data.employees is list &&
                              request.resource.data.days is list;
      allow delete: if false;
    }

    // User credentials (PINs and roles)
    match /user_credentials/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.userId is string &&
                              request.resource.data.pin is string;
      allow delete: if false;
    }
  }
}
